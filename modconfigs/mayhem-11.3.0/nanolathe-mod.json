{
  "schema": 2,
  "id": "mayhem",
  "name": "Total Mayhem",
  "version": "11.3.0+nanolathe.1",
  "summary": "Experimental Total Mayhem 11.3.0 compatibility. Some patch-era gameplay and controls remain unverified.",
  "homepage": "https://mayhem.tauniverse.com/totalm.htm",
  "requires": [],
  "content": {
    "detect": ["downloadsM", "guiM", "unitpicM", "weaponM"],
    "layout": {
      "download": "downloadsM",
      "guis": "guiM",
      "unitpics": "unitpicM",
      "weapons": "weaponM"
    },
    "limits": {
      "units": 16000,
      "weapons": 16000,
      "tnt_bytes": 67108864,
      "los_bytes": 8388608
    }
  },
  "rules": {
    "minimumGameplay": "community-3.9",
    "gameplay": "community-3.9",
    "communityFeatures": {
      "constructionKickout": true,
      "guardingBuildersHold": true,
      "patrollingBuilderFilters": true,
      "reclaimToggleKeepsBuild": true,
      "structureRotation": true,
      "areaDamageOverflow": true,
      "areaDamageDedupCap": true,
      "gridClaimTieBreak": true,
      "transportedExplosions": true,
      "buildWeaponSlotGuard": false,
      "antinukeCircularCoverage": true,
      "alliedJammingIgnored": true,
      "resurrectionFinalization": true,
      "weaponTargetKeys": true,
      "veterancy": true,
      "schemaUnits": true,
      "airCorpseFall": false,
      "scriptPorts": true,
      "mexSnap": true,
      "wreckSnap": true,
      "aiDifficultyIncome": false,
      "aiStockpileProducts": false,
      "targetLockRelease": false,
      "aiApplianceEnergy": false,
      "aiBuilderStopThreshold": false,
      "workingWeaponsAutonomous": false,
      "attackSingleSlotTake": false,
      "mapFeatureOwnerEleven": false,
      "resurrectionTextFix": false,
      "healTimeBitmask": false,
      "aiBuilderPlacementLimit": 0,
      "repairRate": {
        "enabled": false,
        "repairMultiplier": 1,
        "selfHealMultiplier": 1
      },
      "offMapAircraftMarginTiles": 32,
      "projectileCapacity": 3000,
      "explosionCapacity": 3000,
      "debrisCapacity": 1000,
      "sfxLimit": 20480,
      "pathStepAllowance": 66650,
      "unitLimit": 1500,
      "mexSnapRadius": 3,
      "wreckSnapRadius": 1,
      "mexSnapRadiusMax": 3,
      "wreckSnapRadiusMax": 1
    }
  },
  "locks": []
}
