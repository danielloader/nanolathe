#!/bin/sh
# Play one battle in the experimental native Metal renderer (macOS,
# docs/DESIGN_METAL_RENDERER.md). Builds with the Go toolchain alone and
# passes every argument through, so --map, --seed, --metal-size and
# --metal-report override the defaults below.
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ "$(uname -s)" != Darwin ]; then
    echo 'nanolathe: the Metal renderer requires macOS' >&2
    exit 1
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
CGO_ENABLED=0 go build -o "$work/nanolathe" ./cmd/nanolathe
"$work/nanolathe" --metal --map 'The Pass' --ai-player all=modern "$@"
